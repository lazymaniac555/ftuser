{
    "name": "freqtrade user",
    "image": "freqtradeorg/freqtrade:stable_freqairl",
    // Use 'forwardPorts' to make a list of ports inside the container available locally.
    "forwardPorts": [
        8080
    ],
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/ftuser,type=bind,consistency=cached",
    // Uncomment to connect as a non-root user if you've added one. See https://aka.ms/vscode-remote/containers/non-root.
    "remoteUser": "ftuser",
    "workspaceFolder": "/workspaces/ftuser",
    "postStartCommand": "nohup bash -c 'freqtrade webserver --no-color --userdir /workspaces/ftuser/user_data --config /workspaces/ftuser/user_data/config.json --logfile /workspaces/ftuser/user_data/logs/freqtrade.log&' > /dev/null",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.shell.linux": "/bin/bash",
                "editor.insertSpaces": true,
                "files.trimTrailingWhitespace": true,
                "[markdown]": {
                    "files.trimTrailingWhitespace": false
                },
                "python.pythonPath": "/usr/local/bin/python",
                "python.analysis.extraPaths": [
                    "/freqtrade"
                ],
                "python.autoComplete.extraPaths": [
                    "/freqtrade"
                ],
                "[python]": {
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": "explicit"
                    },
                    "editor.formatOnSave": true,
                    "editor.defaultFormatter": "charliermarsh.ruff"
                }
            },
            // Add the IDs of extensions you want installed when the container is created.
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "davidanson.vscode-markdownlint",
                "ms-azuretools.vscode-docker",
                "vscode-icons-team.vscode-icons",
                "github.remotehub",
                "github.vscode-github-actions",
            ],
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/git-lfs:1": {
            "version": "latest"
        }
    }
}
